generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE / SHARED MODELS
// ============================================

model Branch {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  type        BranchType
  address     String?
  city        String?
  state       String?
  postcode    String?
  country     String    @default("Malaysia")
  phone       String?
  email       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  users       User[]
  warehouses  Warehouse[]
  vehicles    Vehicle[]
  customers   Customer[]
  vendors     Vendor[]
  @@map("branches")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  lastLogin     DateTime?
  lastLoginIp   String?
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  role          UserRole  @default(OPERATOR)
  permissions   String[]  @default([])
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id])
  auditLogs     AuditLog[]
  sessions      Session[]
  driverProfile Driver?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  createdAt    DateTime @default(now())
  @@map("sessions")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entityType  String
  entityId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// HMS - HAULAGE MANAGEMENT SYSTEM
// ============================================

model Vehicle {
  id              String          @id @default(cuid())
  registrationNo  String          @unique
  chassisNo       String?         @unique
  engineNo        String?         @unique
  type            VehicleType
  make            String?
  model           String?
  year            Int?
  color           String?
  gvw             Float?
  capacity        Float?
  fuelType        FuelType        @default(DIESEL)
  gpsDeviceId     String?
  gpsProvider     String?
  status          VehicleStatus   @default(ACTIVE)
  currentBranchId String
  currentBranch   Branch          @relation(fields: [currentBranchId], references: [id])
  roadTaxExpiry   DateTime?
  insuranceExpiry DateTime?
  puspakomExpiry  DateTime?
  permitExpiry    DateTime?
  jobs            HaulageJob[]
  maintenance     MaintenanceRecord[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  @@map("vehicles")
}

model Driver {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  licenseNo       String
  licenseClass    String[]
  licenseExpiry   DateTime
  employeeNo      String?   @unique
  joiningDate     DateTime?
  emergencyContact String?
  emergencyPhone   String?
  address          String?
  rating          Float     @default(5.0)
  totalJobs       Int       @default(0)
  jobs            HaulageJob[]
  incentives      DriverIncentive[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@map("drivers")
}

model Trailer {
  id              String        @id @default(cuid())
  registrationNo  String        @unique
  type            TrailerType
  size            String
  tareWeight      Float?
  maxGrossWeight  Float?
  puspakomExpiry  DateTime?
  permitExpiry    DateTime?
  status          TrailerStatus @default(AVAILABLE)
  jobs            HaulageJob[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@map("trailers")
}

model HaulageJob {
  id                String          @id @default(cuid())
  jobNo             String          @unique
  status            HaulageJobStatus @default(PENDING)
  vehicleId         String?
  vehicle           Vehicle?        @relation(fields: [vehicleId], references: [id])
  driverId          String?
  driver            Driver?         @relation(fields: [driverId], references: [id])
  trailerId         String?
  trailer           Trailer?        @relation(fields: [trailerId], references: [id])
  containerNo       String?
  containerSize     String?
  containerType     String?
  sealNo            String?
  pickupLocation    String
  pickupAddress     String?
  pickupLat         Float?
  pickupLng         Float?
  pickupTime        DateTime?
  deliveryLocation  String
  deliveryAddress   String?
  deliveryLat       Float?
  deliveryLng       Float?
  deliveryTime      DateTime?
  vesselName        String?
  voyageNo          String?
  eta               DateTime?
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id])
  cargoDesc         String?
  weight            Float?
  instructions      String?
  rate              Float?
  currency          String          @default("MYR")
  gpsTracking       Json[]
  pickupPhoto       String?
  deliveryPhoto     String?
  pickupSignature   String?
  deliverySignature String?
  podReceived       Boolean         @default(false)
  podDate           DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  @@index([status])
  @@index([driverId])
  @@index([vehicleId])
  @@index([jobNo])
  @@map("haulage_jobs")
}

model MaintenanceRecord {
  id              String          @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  type            MaintenanceType
  description     String
  cost            Float?
  workshopName    String?
  scheduledDate   DateTime?
  completedDate   DateTime?
  odometerReading Int?
  invoiceNo       String?
  attachments     String[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  @@map("maintenance_records")
}

model DriverIncentive {
  id          String    @id @default(cuid())
  driverId    String
  driver      Driver    @relation(fields: [driverId], references: [id])
  period      String
  amount      Float
  formula     String
  isPaid      Boolean   @default(false)
  paidDate    DateTime?
  paidBy      String?
  createdAt   DateTime  @default(now())
  @@map("driver_incentives")
}

// ============================================
// FFS - FORWARDING MANAGEMENT SYSTEM
// ============================================

model Shipment {
  id              String          @id @default(cuid())
  shipmentNo      String          @unique
  bookingNo       String?
  mode            TransportMode
  type            ShipmentType    @default(FCL)
  status          ShipmentStatus  @default(BOOKED)
  shipperId       String
  shipper         Customer        @relation("ShipperShipments", fields: [shipperId], references: [id])
  consigneeId     String
  consignee       Customer        @relation("ConsigneeShipments", fields: [consigneeId], references: [id])
  notifyPartyId   String?
  notifyParty     Customer?       @relation("NotifyPartyShipments", fields: [notifyPartyId], references: [id])
  origin          String
  destination     String
  pol             String?
  pod             String?
  etd             DateTime?
  eta             DateTime?
  actualDeparture DateTime?
  actualArrival   DateTime?
  carrierId       String?
  carrier         Vendor?         @relation(fields: [carrierId], references: [id])
  vesselName      String?
  voyageNo        String?
  cargoDesc       String
  packages        Int?
  packageType     String?
  grossWeight     Float?
  volume          Float?
  blNo            String?         @unique
  awbNo           String?         @unique
  sellingCurrency String          @default("MYR")
  buyingCurrency  String          @default("MYR")
  containers      Container[]
  customsEntries  CustomsEntry[]
  documents       Document[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  @@index([status])
  @@index([shipmentNo])
  @@map("shipments")
}

model Container {
  id              String      @id @default(cuid())
  containerNo     String
  size            String
  type            String?
  sealNo          String?
  shipmentId      String
  shipment        Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  tareWeight      Float?
  grossWeight     Float?
  volume          Float?
  haulageJobId    String?
  createdAt       DateTime    @default(now())
  @@map("containers")
}

model CustomsEntry {
  id              String          @id @default(cuid())
  entryNo         String          @unique
  shipmentId      String
  shipment        Shipment        @relation(fields: [shipmentId], references: [id])
  type            CustomsType
  k1No            String?
  k8No            String?
  k9No            String?
  status          CustomsStatus   @default(PENDING)
  submissionDate  DateTime?
  clearanceDate   DateTime?
  totalDuties     Float?
  totalTaxes      Float?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  @@map("customs_entries")
}

// ============================================
// WMS - WAREHOUSE MANAGEMENT SYSTEM
// ============================================

model Warehouse {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  branchId    String
  branch      Branch      @relation(fields: [branchId], references: [id])
  address     String?
  totalArea   Float?
  locations   WarehouseLocation[]
  inventory   Inventory[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@map("warehouses")
}

model WarehouseLocation {
  id          String        @id @default(cuid())
  code        String
  zone        String
  aisle       String?
  rack        String?
  level       String?
  bin         String?
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  type        LocationType  @default(STANDARD)
  capacity    Float?
  inventory   Inventory[]
  @@unique([warehouseId, code])
  @@map("warehouse_locations")
}

model Inventory {
  id          String          @id @default(cuid())
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  locationId  String?
  location    WarehouseLocation? @relation(fields: [locationId], references: [id])
  sku         String
  description String?
  batchNo     String?
  quantity    Float
  uom         String          @default("PCS")
  status      InventoryStatus @default(AVAILABLE)
  receivedAt  DateTime        @default(now())
  expiryDate  DateTime?
  movements   InventoryMovement[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@index([sku])
  @@index([status])
  @@map("inventory")
}

model InventoryMovement {
  id            String        @id @default(cuid())
  inventoryId   String
  inventory     Inventory     @relation(fields: [inventoryId], references: [id])
  type          MovementType
  quantity      Float
  referenceNo   String?
  referenceType String?
  notes         String?
  createdBy     String?
  createdAt     DateTime      @default(now())
  @@map("inventory_movements")
}

// ============================================
// TMS - TERMINAL MANAGEMENT SYSTEM
// ============================================

model YardBlock {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  rows        Int
  tiers       Int       @default(0)
  slots       YardSlot[]
  createdAt   DateTime  @default(now())
  @@map("yard_blocks")
}

model YardSlot {
  id          String    @id @default(cuid())
  blockId     String
  block       YardBlock @relation(fields: [blockId], references: [id])
  row         String
  slot        String
  tier        Int       @default(0)
  containerNo String?   @unique
  occupiedAt  DateTime?
  @@unique([blockId, row, slot])
  @@map("yard_slots")
}

model GatePass {
  id          String        @id @default(cuid())
  passNo      String        @unique
  type        GatePassType
  containerNo String
  size        String?
  haulierId   String?
  haulier     Vendor?       @relation(fields: [haulierId], references: [id])
  truckRegNo  String?
  driverName  String?
  shipmentId  String?
  bookingNo   String?
  status      GatePassStatus @default(PENDING)
  validFrom   DateTime
  validUntil  DateTime?
  gateInAt    DateTime?
  gateOutAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@map("gate_passes")
}

// ============================================
// FMS - FINANCE MANAGEMENT SYSTEM
// ============================================

model Customer {
  id              String        @id @default(cuid())
  code            String        @unique
  name            String
  type            PartyType     @default(CUSTOMER)
  address         String?
  city            String?
  state           String?
  postcode        String?
  country         String        @default("Malaysia")
  phone           String?
  email           String?
  regNo           String?
  taxNo           String?
  creditLimit     Float         @default(0)
  creditDays      Int           @default(30)
  creditStatus    CreditStatus  @default(ACTIVE)
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id])
  invoices        Invoice[]     @relation("CustomerInvoices")
  shipmentsAsShipper    Shipment[] @relation("ShipperShipments")
  shipmentsAsConsignee  Shipment[] @relation("ConsigneeShipments")
  shipmentsAsNotify     Shipment[] @relation("NotifyPartyShipments")
  haulageJobs     HaulageJob[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@map("customers")
}

model Vendor {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  type        PartyType   @default(VENDOR)
  address     String?
  city        String?
  state       String?
  postcode    String?
  country     String      @default("Malaysia")
  phone       String?
  email       String?
  regNo       String?
  taxNo       String?
  branchId    String
  branch      Branch      @relation(fields: [branchId], references: [id])
  bills       Invoice[]   @relation("VendorInvoices")
  shipments   Shipment[]
  gatePasses  GatePass[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@map("vendors")
}

model Invoice {
  id                String        @id @default(cuid())
  invoiceNo         String        @unique
  type              InvoiceType
  customerId        String?
  customer          Customer?     @relation("CustomerInvoices", fields: [customerId], references: [id])
  vendorId          String?
  vendor            Vendor?       @relation("VendorInvoices", fields: [vendorId], references: [id])
  invoiceDate       DateTime      @default(now())
  dueDate           DateTime
  subtotal          Float
  taxAmount         Float         @default(0)
  total             Float
  paidAmount        Float         @default(0)
  balance           Float
  currency          String        @default("MYR")
  exchangeRate      Float         @default(1)
  status            InvoiceStatus @default(DRAFT)
  eInvoiceUuid      String?       @unique
  eInvoiceStatus    EInvoiceStatus @default(PENDING)
  eInvoiceValidatedAt DateTime?
  items             InvoiceItem[]
  payments          Payment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([status])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceItem {
  id            String    @id @default(cuid())
  invoiceId     String
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description   String
  quantity      Float     @default(1)
  unitPrice     Float
  amount        Float
  taxCode       String?
  taxAmount     Float     @default(0)
  referenceType String?
  referenceId   String?
  @@map("invoice_items")
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  amount        Float
  method        PaymentMethod @default(BANK_TRANSFER)
  referenceNo   String?
  bankName      String?
  accountNo     String?
  paymentDate   DateTime      @default(now())
  notes         String?
  createdAt     DateTime      @default(now())
  @@map("payments")
}

model Account {
  id              String        @id @default(cuid())
  code            String        @unique
  name            String
  type            AccountType
  category        String?
  openingBalance  Float         @default(0)
  currentBalance  Float         @default(0)
  isActive        Boolean       @default(true)
  journalLines    JournalLine[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@map("accounts")
}

model JournalEntry {
  id          String        @id @default(cuid())
  entryNo     String        @unique
  date        DateTime      @default(now())
  reference   String?
  description String
  totalDebit  Float
  totalCredit Float
  status      JournalStatus @default(DRAFT)
  postedAt    DateTime?
  postedBy    String?
  lines       JournalLine[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@map("journal_entries")
}

model JournalLine {
  id              String        @id @default(cuid())
  entryId         String
  entry           JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account       @relation(fields: [accountId], references: [id])
  description     String?
  debit           Float         @default(0)
  credit          Float         @default(0)
  referenceType   String?
  referenceId     String?
  @@map("journal_lines")
}

model FixedAsset {
  id                      String              @id @default(cuid())
  assetNo                 String              @unique
  description             String
  category                String
  purchaseDate            DateTime
  purchaseCost            Float
  depreciationMethod      DepreciationMethod  @default(STRAIGHT_LINE)
  usefulLifeYears         Int
  salvageValue            Float               @default(0)
  accumulatedDepreciation Float               @default(0)
  netBookValue            Float
  location                String?
  status                  AssetStatus         @default(ACTIVE)
  disposedAt              DateTime?
  disposalValue           Float?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  @@map("fixed_assets")
}

model Document {
  id            String    @id @default(cuid())
  filename      String
  originalName  String
  mimeType      String
  size          Int
  path          String
  entityType    String
  entityId      String
  shipmentId    String?
  shipment      Shipment? @relation(fields: [shipmentId], references: [id])
  uploadedBy    String?
  uploadedAt    DateTime  @default(now())
  @@index([entityType, entityId])
  @@map("documents")
}

// ============================================
// ENUMS
// ============================================

enum BranchType { HEADQUARTERS PORT TERMINAL WAREHOUSE OFFICE }
enum UserRole { SUPER_ADMIN BRANCH_ADMIN MANAGER SUPERVISOR OPERATOR READ_ONLY DRIVER }
enum VehicleType { PRIME_MOVER LORRY VAN TRAILER_ONLY }
enum FuelType { DIESEL PETROL ELECTRIC HYBRID }
enum VehicleStatus { ACTIVE MAINTENANCE RETIRED SOLD }
enum TrailerType { FLATBED SKELETAL BOX REEFER TANKER }
enum TrailerStatus { AVAILABLE IN_USE MAINTENANCE DAMAGED }
enum HaulageJobStatus { PENDING ASSIGNED DISPATCHED AT_PICKUP LOADED IN_TRANSIT AT_DELIVERY DELIVERED COMPLETED CANCELLED }
enum MaintenanceType { PREVENTIVE CORRECTIVE PREDICTIVE PUSPAKOM REGULATORY }
enum TransportMode { SEA AIR LAND RAIL MULTIMODAL }
enum ShipmentType { FCL LCL BREAKBULK RO_RO }
enum ShipmentStatus { BOOKED CONFIRMED IN_TRANSIT ARRIVED CUSTOMS_HOLD CLEARED DELIVERED COMPLETED CANCELLED }
enum CustomsType { IMPORT EXPORT TRANSIT }
enum CustomsStatus { PENDING SUBMITTED PROCESSING INSPECTED CLEARED REJECTED RELEASED }
enum LocationType { STANDARD BULK REFRIGERATED HAZARDOUS OVERSIZE PICKING RECEIVING SHIPPING }
enum InventoryStatus { AVAILABLE RESERVED QUARANTINE DAMAGED EXPIRED IN_TRANSIT }
enum MovementType { RECEIPT ISSUE TRANSFER_IN TRANSFER_OUT ADJUSTMENT RETURN }
enum GatePassType { GATE_IN GATE_OUT }
enum GatePassStatus { PENDING APPROVED USED EXPIRED CANCELLED }
enum PartyType { CUSTOMER VENDOR AGENT HAULIER CARRIER }
enum CreditStatus { ACTIVE HOLD SUSPENDED BLACKLISTED }
enum InvoiceType { SALES PURCHASE CREDIT_NOTE DEBIT_NOTE }
enum InvoiceStatus { DRAFT SENT PARTIAL PAID OVERDUE VOID CANCELLED }
enum EInvoiceStatus { PENDING VALIDATED REJECTED CANCELLED }
enum PaymentMethod { CASH CHEQUE BANK_TRANSFER CREDIT_CARD ONLINE }
enum AccountType { ASSET LIABILITY EQUITY REVENUE EXPENSE }
enum JournalStatus { DRAFT POSTED REVERSED }
enum DepreciationMethod { STRAIGHT_LINE REDUCING_BALANCE UNITS_OF_PRODUCTION }
enum AssetStatus { ACTIVE UNDER_MAINTENANCE IDLE DISPOSED }
